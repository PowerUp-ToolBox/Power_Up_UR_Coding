    },
    {
      "name": "skipped lines do not count toward maxEntries",
      "input": {
        "file": "{\"id\":\"3F2504E0-4F89-41D3-9A0C-0305E82C3301\",\"kind\":\"user\",\"text\":\"one\",\"date\":1761700000}\n{\"id\":\"3F2504E0-4F89-41D3-9A0C-0305E82C3301\",\"kind\":\"user\",\"text\":\"two\",\"date\":1761700000}\ngarbage\n",
        "maxEntries": 2
