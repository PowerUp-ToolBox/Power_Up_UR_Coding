    {
      "name": "corrupt and future lines are skipped",
      "input": {
        "file": "{\"id\":\"3F2504E0-4F89-41D3-9A0C-0305E82C3301\",\"kind\":\"user\",\"text\":\"first\",\"date\":1761700000}\nnot json at all\n{\"future\":\"shape\"}\n{\"id\":\"3F2504E0-4F89-41D3-9A0C-0305E82C3301\",\"kind\":\"assistant\",\"text\":\"second\",\"date\":1761700000}\n",
        "maxEntries": 200
