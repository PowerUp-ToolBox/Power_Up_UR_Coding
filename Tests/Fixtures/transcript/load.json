    },
    {
      "name": "no final newline",
      "input": {
        "file": "{\"id\":\"3F2504E0-4F89-41D3-9A0C-0305E82C3301\",\"kind\":\"user\",\"text\":\"one\",\"date\":1761700000}\n{\"id\":\"3F2504E0-4F89-41D3-9A0C-0305E82C3301\",\"kind\":\"user\",\"text\":\"two\",\"date\":1761700000}",
        "maxEntries": 200
      },
      "expected": {
        "rewrite": false,
        "texts": [
          "one",
          "two"
        ]
      },
      "reason": "The last line counts without its newline (a crash mid-append leaves one)."
    },
    {
      "name": "a CRLF file",
      "input": {
        "file": "{\"id\":\"3F2504E0-4F89-41D3-9A0C-0305E82C3301\",\"kind\":\"user\",\"text\":\"one\",\"date\":1761700000}\r\n{\"id\":\"3F2504E0-4F89-41D3-9A0C-0305E82C3301\",\"kind\":\"user\",\"text\":\"two\",\"date\":1761700000}\r\n",
