    {
      "name": "blank lines are dropped",
      "input": {
        "file": "\n\n{\"id\":\"3F2504E0-4F89-41D3-9A0C-0305E82C3301\",\"kind\":\"user\",\"text\":\"one\",\"date\":1761700000}\n\n\n{\"id\":\"3F2504E0-4F89-41D3-9A0C-0305E82C3301\",\"kind\":\"user\",\"text\":\"two\",\"date\":1761700000}\n\n",
        "maxEntries": 200
      },
      "expected": {
        "rewrite": false,
        "texts": [
          "one",
          "two"
        ]
      },
