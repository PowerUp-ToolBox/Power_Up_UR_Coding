      "expected": {
        "effects": [
          {
            "effect": "beginCapture",
            "mode": "send"
          }
        ],
        "owner": "r2"
      },
      "reason": "Ownership is the control that started the hold (v2.7 C; HoldTrackerTests.testHoldPressBeginsACaptureWithTheActionsModeAndRecordsTheOwner)."
    },
