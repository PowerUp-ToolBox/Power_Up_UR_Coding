{
  "formatVersion": 1,
  "name": "permission-cycle-never-reaches-bypass",
  "description": "Cycle Permission Mode steps a running session through acceptEdits → plan → default and back to acceptEdits, sending each mode to the harness live. However often it is pressed, it never lands on bypassPermissions.",
  "reason": "bypassPermissions approves everything without asking. A stray button press, or a protocol client, must never be able to switch safety off; only the Settings window can choose it.",
  "source": "DESIGN.md v1.7 'Safety invariants' 1; AppConfig.permissionModeCycle; AppState.cyclePermissionMode",
  "verifiedBy": ["swift", "rust"],
  "config": {
    "harnessKind": "claude",
    "controlMode": "builtin",
    "permissionMode": "acceptEdits",
    "project": true
  },
  "script": [
    { "call": "startSessionIfNeeded" },
    {
      "harnessEvent": { "type": "sessionReady", "sessionID": "session-1", "model": "claude-sonnet-4-5" }
    },
    { "intent": "cyclePermissionMode", "expect": { "permissionMode": "plan" } },
    { "intent": "cyclePermissionMode", "expect": { "permissionMode": "default" } },
    {
      "intent": "cyclePermissionMode",
      "reason": "After default the cycle wraps to acceptEdits; bypassPermissions is not in it.",
      "expect": { "permissionMode": "acceptEdits" }
    },
    { "intent": "cyclePermissionMode", "expect": { "permissionMode": "plan" } }
  ],
  "expect": {
    "permissionMode": "plan",
    "harnessCalls": [
      { "adapter": "claude", "type": "start", "permissionMode": "acceptEdits" },
      { "adapter": "claude", "type": "setPermissionMode", "mode": "plan" },
      { "adapter": "claude", "type": "setPermissionMode", "mode": "default" },
      { "adapter": "claude", "type": "setPermissionMode", "mode": "acceptEdits" },
      { "adapter": "claude", "type": "setPermissionMode", "mode": "plan" }
    ],
    "transcript": [
      { "kind": "system", "text": "Session started (claude-sonnet-4-5)" },
      { "kind": "system", "text": "Permissions → plan" },
      { "kind": "system", "text": "Permissions → default" },
      { "kind": "system", "text": "Permissions → acceptEdits" },
      { "kind": "system", "text": "Permissions → plan" }
    ]
  }
}
