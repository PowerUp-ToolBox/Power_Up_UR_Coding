        }
      ],
      "reason": "HK-403: locations casts all-or-nothing to an array of objects, so one bad element hides even a good first one."
    },
    {
      "name": "rawInput keys go in a fixed order",
      "input": "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s1\",\"update\":{\"sessionUpdate\":\"tool_call\",\"toolCallId\":\"t1\",\"title\":\"Bash\",\"rawInput\":{\"command\":\"ls\",\"file_path\":\"/a/b.txt\"}}}}",
      "expected": [
