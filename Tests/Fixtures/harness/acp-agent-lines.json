      "reason": "HK-150: only the first location is tried; the second is never looked at."
    },
    {
      "name": "an empty first path falls through to rawInput",
      "input": "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s1\",\"update\":{\"sessionUpdate\":\"tool_call\",\"toolCallId\":\"t1\",\"title\":\"Run\",\"locations\":[{\"path\":\"\"}],\"rawInput\":{\"command\":\"make\"}}}}",
      "expected": [
        {
          "effect": "emit",
          "event": {
            "type": "toolUse",
            "name": "Run",
            "detail": "make"
          }
        }
      ],
      "reason": "HK-150: an empty path is no path."
    },
    {
      "name": "a non-object location empties the list",
      "input": "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s1\",\"update\":{\"sessionUpdate\":\"tool_call\",\"toolCallId\":\"t1\",\"title\":\"Edit\",\"locations\":[{\"path\":\"/work/a.swift\"},5],\"rawInput\":{\"file_path\":\"/work/z.txt\"}}}}",
      "expected": [
        {
          "effect": "emit",
          "event": {
            "type": "toolUse",
            "name": "Edit",
            "detail": "/work/z.txt"
          }
        }
      ],
      "reason": "HK-403: locations casts all-or-nothing to an array of objects, so one bad element hides even a good first one."
    },
    {
      "name": "rawInput keys go in a fixed order",
      "input": "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s1\",\"update\":{\"sessionUpdate\":\"tool_call\",\"toolCallId\":\"t1\",\"title\":\"Bash\",\"rawInput\":{\"command\":\"ls\",\"file_path\":\"/a/b.txt\"}}}}",
      "expected": [
